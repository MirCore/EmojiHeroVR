<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; position: absolute; right: 0; bottom: 0; width: 311px;">
        <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="ScrollView" style="padding-left: 5px;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; padding-top: 0;">
                <ui:ProgressBar value="0" title="Anger" name="Anger" high-value="1">
                    <Bindings>
                        <ui:DataBinding property="value" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="Probabilities.anger" />
                    </Bindings>
                </ui:ProgressBar>
                <ui:ProgressBar value="0" title="Disgust" name="Disgust" high-value="1">
                    <Bindings>
                        <ui:DataBinding property="value" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="Probabilities.disgust"/>
                    </Bindings>
                </ui:ProgressBar>
                <ui:ProgressBar value="0" title="Fear" name="Fear" high-value="1" />
                <Bindings>
                    <ui:DataBinding property="value" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="Probabilities.fear"/>
                </Bindings>
                <ui:ProgressBar value="0" title="Happiness" name="Happiness" high-value="1" />
                <Bindings>
                    <ui:DataBinding property="value" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="Probabilities.happiness"/>
                </Bindings>
                <ui:ProgressBar value="0" title="Neutral" name="Neutral" high-value="1" />
                <Bindings>
                    <ui:DataBinding property="value" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="Probabilities.neutral"/>
                </Bindings>
                <ui:ProgressBar value="0" title="Sadness" name="Sadness" high-value="1" />
                <Bindings>
                    <ui:DataBinding property="value" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="Probabilities.sadness"/>
                </Bindings>
                <ui:ProgressBar value="0" title="Surprise" name="Surprise" high-value="1" />
                <Bindings>
                    <ui:DataBinding property="value" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="Probabilities.surprise"/>
                </Bindings>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; margin-top: 5px;">
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                        <ui:Label tabindex="-1" text="Pending FER:" parse-escape-sequences="true" display-tooltip-when-elided="true" class="title" style="flex-shrink: 1;" />
                        <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="PendingRestResponses" style="min-width: 20px;">
                            <Bindings>
                                <ui:DataBinding property="text" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="PendingFer" />
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                        <ui:Label tabindex="-1" text="Total FER calls:" parse-escape-sequences="true" display-tooltip-when-elided="true" class="title" style="flex-shrink: 1;" />
                        <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TotalRestCalls" style="min-width: 20px;">
                            <Bindings>
                                <ui:DataBinding property="text" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="TotalFer" />
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                        <ui:Label tabindex="-1" text="FER FPS:" parse-escape-sequences="true" display-tooltip-when-elided="true" class="title" style="flex-shrink: 1;" />
                        <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="PostsFPS" style="min-width: 20px; -unity-text-align: upper-right;">
                            <Bindings>
                                <ui:DataBinding property="text" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="CurrentFerFPS" />
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                        <ui:Label tabindex="-1" text="Snapshot FPS:" parse-escape-sequences="true" display-tooltip-when-elided="true" class="title" />
                        <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SnapshotFPS" style="min-width: 20px;">
                            <Bindings>
                                <ui:DataBinding property="text" binding-mode="ToTarget" data-source="project://database/Assets/Resources/DebugData/DebugData.asset?fileID=11400000&amp;guid=70184b5107bc25b43a4f0d5147177457&amp;type=2#DebugData" data-source-path="SnapshotFPS" />
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
